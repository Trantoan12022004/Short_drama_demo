        <activity
            android:name="com.demo.miniflicks.dramaseries.shortstory.ui.permission.PermissionActivityOscar"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="app"
                    android:path="/PermissionActivity"
                    android:scheme="example" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.demo.miniflicks.dramaseries.shortstory.ui.home.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="app"
                    android:path="/HomeActivity"
                    android:scheme="example" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.demo.miniflicks.dramaseries.shortstory.ui.policy.PolicyActivityOscar"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.demo.miniflicks.dramaseries.shortstory.ui.about.AboutActivityOscar"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.demo.miniflicks.dramaseries.shortstory.ui.setting.SettingActivityOscar"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <service
            android:name="com.demo.miniflicks.dramaseries.shortstory.service.FirebaseServiceOscar"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
                <action android:name="android.intent.action.PICK" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
            </intent-filter>
        </service>


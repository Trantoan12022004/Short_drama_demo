    <!-- LỚP 4: Vệt sáng bóng mép trên (Top Glass Highlight) -->
    <item
        android:height="1.5dp"
        android:left="30dp"
        android:right="30dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#509DD9"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginEnd="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Skeleton: Poster image placeholder (cùng tỉ lệ 3:4 với item thật) -->
    <View
        android:id="@+id/skeletonPosterOscar"
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Skeleton: View count dưới góc phải poster -->
    <View
        android:id="@+id/skeletonViewCountOscar"
        android:layout_width="50dp"
        android:layout_height="14dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintBottom_toBottomOf="@id/skeletonPosterOscar"
        app:layout_constraintEnd_toEndOf="@id/skeletonPosterOscar" />

    <!-- Skeleton: Tên phim dưới poster -->
    <View
        android:id="@+id/skeletonMovieTitleOscar"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintTop_toBottomOf="@id/skeletonPosterOscar"
        app:layout_constraintStart_toStartOf="@id/skeletonPosterOscar"
        app:layout_constraintEnd_toEndOf="@id/skeletonPosterOscar"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

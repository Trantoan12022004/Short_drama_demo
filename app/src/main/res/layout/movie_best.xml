<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/ivCardMovieOscar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        android:contentDescription="@string/cd_movie_poster"
        android:scaleType="centerCrop"
        android:src="@drawable/card_demo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="16dp" />

    <!-- Vòng xoay loading khi ảnh chưa tải xong -->
    <ProgressBar
        android:id="@+id/pbLoadingOscar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/ivCardMovieOscar"
        app:layout_constraintBottom_toBottomOf="@id/ivCardMovieOscar"
        app:layout_constraintStart_toStartOf="@id/ivCardMovieOscar"
        app:layout_constraintEnd_toEndOf="@id/ivCardMovieOscar" />
    <View
        android:id="@+id/viewGradientOscar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_black_gradient"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/ivCardMovieOscar"
        app:layout_constraintStart_toStartOf="@id/ivCardMovieOscar"
        app:layout_constraintEnd_toEndOf="@id/ivCardMovieOscar" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_100"
        android:padding="4dp"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cup"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_s_choice"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_18pt_semibold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_btn_1000"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#5C090A0C"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintWidth_default="wrap">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/gradient_yellow_circle"
            android:padding="12dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/tvMovieTitleOscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_semibold"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="The Legend Of Hei"
            android:textSize="14sp" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
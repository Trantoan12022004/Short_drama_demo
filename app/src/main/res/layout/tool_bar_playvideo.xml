<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
>
    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/glassToolbarOscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:cornerRadius="32dp"
        app:glassMaterial="clear"
        app:refractionHeight="120dp"
        app:bevelWidth="12dp"
        app:dispersionStrength="0.08"
        app:sensorHighlight="true"
        app:adaptiveTint="true">

        <!-- Nội dung bên trong thanh công cụ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <!-- Nút Back -->
            <ImageView
                android:id="@+id/btnBackOscar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_right2" />

            <!-- Tiêu đề -->
            <TextView
                android:id="@+id/toolbarTitleOscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Skrill and Iso"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/sf_pro_rounded_bold" />

            <!-- Nút Yêu thích -->
            <ImageView
                android:id="@+id/btnFavoriteOscar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_favorite3" />

        </LinearLayout>

    </com.example.liquidglass.LiquidGlassView>
</FrameLayout>
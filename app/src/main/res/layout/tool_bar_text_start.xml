<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout
            android:id="@+id/layout_textOscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.demo.miniflicks.dramaseries.shortstory.ui.widget.GradientTextViewOscar
                android:id="@+id/tv_tool_barOscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anton_regular"
                android:includeFontPadding="false"
                android:text="@string/choose_language"
                app:gradientOrientation="topToBottom"
                android:textColor="@color/Orange_50"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_descriptionOscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false"
                android:text="@string/please_select_a_language_to_continue"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>
        <ImageView
            android:id="@+id/iv_rightOscar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:src="@drawable/check" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">



    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewOscar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="zoom"/>

    <ImageView
        android:id="@+id/ivThumbnailOscar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/body_frame"
        android:contentDescription="@null" />

    <!-- Lớp bắt tap pause/play vì PlayerView với use_controller=false không nhận OnClickListener -->
    <View
        android:id="@+id/touchOverlayOscar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Đặt sau overlay để vòng xoay không bị View full-screen che -->
    <ProgressBar
        android:id="@+id/pbLoadingOscar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:clickable="false"
        android:focusable="false"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/groupLockedOscar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_favorite" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/episode_locked"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
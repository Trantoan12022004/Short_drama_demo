<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/frAds">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <!-- Title -->
            <TextView
                android:id="@+id/tv_titleOscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:text="@string/permission_title"
                android:textColor="@color/Orange_50"
                android:textSize="@dimen/_18ssp"
                android:fontFamily="@font/anton_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Image Illustration -->
            <ImageView
                android:id="@+id/iv_chestOscar"
                android:layout_width="360dp"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/_40sdp"
                android:src="@drawable/ic_permission"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_titleOscar" />

            <!-- Description -->
            <TextView
                android:id="@+id/tv_descOscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:gravity="center"
                android:text="@string/permission_desc"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/outfit_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_chestOscar" />

            <!-- Notification Permission Item -->
            <LinearLayout
                android:id="@+id/ll_notificationOscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_lang_item_sn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp"
                app:layout_constraintTop_toBottomOf="@id/tv_descOscar">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_notification"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="@font/outfit_medium" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_notificationOscar"
                    android:layout_width="52dp"
                    android:layout_height="28dp"
                    app:thumbTint="@color/white"
                    app:track="@drawable/switch_track_selector" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_memoryOscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_lang_item_sn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:padding="@dimen/_14sdp"
                app:layout_constraintTop_toBottomOf="@id/ll_notificationOscar">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_memory"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="@font/plusjakartasans_regular" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_memoryOscar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:track="@drawable/switch_track_selector" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_writeOscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_lang_item_sn"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp"
                app:layout_constraintTop_toBottomOf="@id/ll_memoryOscar">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_write"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="@font/plusjakartasans_regular" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_writeOscar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/white"
                    app:track="@drawable/switch_track_selector" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>



    <FrameLayout
        android:id="@+id/frAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tv_continueOscar" />


    <TextView
        android:id="@+id/tv_continueOscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_medium"
        android:layout_marginBottom="@dimen/_6sdp"
        android:text="@string/agree_and_continue"
        android:textColor="@color/Orange_50"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
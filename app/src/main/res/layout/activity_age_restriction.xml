<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainOscar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:padding="16dp"
    tools:context="com.demo.miniflicks.dramaseries.shortstory.ui.age.AgeConfirmActivity">

    <com.demo.miniflicks.dramaseries.shortstory.ui.widget.GradientTextViewOscar
        android:id="@+id/btn_age_confirmOscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/anton_regular"
        android:gravity="center"
        android:text="@string/age_restriction"
        android:textSize="20sp"
        app:endColor="#F12711"
        app:gradientOrientation="topToBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:startColor="#FE8C00" />

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_age_confirmOscar">

        <!-- Icon / Illustration -->
        <ImageView
            android:id="@+id/ivIconOscar"
            android:layout_width="300dp"
            android:layout_height="400dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_age_no" />

        <!-- Title -->
        <com.demo.miniflicks.dramaseries.shortstory.util.AlwaysMarqueeTextViewOscar
            android:id="@+id/tvTitleOscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_18pt_semibold"
            android:gravity="center"
            android:text="@string/oops_this_content_is_not_available"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescriptionOscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:gravity="center"
            android:fontFamily="@font/inter_18pt_medium"
            android:text="@string/age_restriction_description"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <!-- Try Again Button -->
        <com.demo.miniflicks.dramaseries.shortstory.util.AlwaysMarqueeTextViewOscar
            android:id="@+id/btnTryAgainOscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_yes"
            android:fontFamily="@font/inter_18pt_semibold"
            android:gravity="center"
            android:minWidth="160dp"
            android:paddingHorizontal="36dp"
            android:paddingVertical="14dp"
            android:text="@string/try_again"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>